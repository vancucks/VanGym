rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /groups/{inviteCode} {
      allow get: if request.auth != null;
      allow list, delete: if false;
      allow create: if request.auth != null
        && request.resource.data.members.size() == 1
        && request.resource.data.members[0].nickname is string;
      allow update: if request.auth != null
        && resource.data.members.size() < 5
        && request.resource.data.members.size() == resource.data.members.size() + 1
        && request.resource.data.members.size() <= 5
        && request.resource.data.members.hasAll(resource.data.members)
        && request.resource.data.name == resource.data.name
        && request.resource.data.code == resource.data.code
        && request.resource.data.duration == resource.data.duration
        && request.resource.data.joinedAt == resource.data.joinedAt;
    }
  }
}
